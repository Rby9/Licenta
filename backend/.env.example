# Copiază acest fișier în backend/.env și completează valorile locale.
# Valorile de mai jos sunt exemple, nu credențiale funcționale.
# Nu publica fișierul .env completat.

# Conexiunea la serverul MySQL și baza deja pregătită.
DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=licenta_booking

# Înlocuiește cu o valoare aleatoare, lungă și privată pentru semnarea tokenurilor.
JWT_SECRET=replace_with_a_long_random_private_value

# Opțional: cheia secretă Stripe pentru modul de test, din propriul cont.
# Fără această cheie, API-ul pornește, iar plățile online răspund cu 503.
STRIPE_SECRET_KEY=

# Backendul folosește serviciul Gmail pentru trimiterea emailurilor.
EMAIL_USER=
EMAIL_PASS=

# Setări HTTP locale (portul 5000 rămâne liber).
HOST=127.0.0.1
PORT=5001
SITE_URL=http://localhost:5173
DB_PORT=3306

# Opțional: secretul de semnare pentru endpointul /api/plati/webhook.
# Se obține din configurația Stripe a endpointului; nu este cheia API.
STRIPE_WEBHOOK_SECRET=

# Expeditorul emailurilor; trebuie să corespundă contului configurat.
EMAIL_FROM="HoteluriRo <your-account@example.com>"
